# ResumeForge Environment Variables
# Copy this file to .env and fill in your actual values

# Stripe Configuration (required for payment processing)
# Get these from your Stripe Dashboard: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID=price_your_price_id_here

# Frontend URL (used for Stripe checkout redirects)
APP_FRONTEND_URL=http://localhost:8081

# CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8081

# SMTP / Email Configuration (optional - for payment receipts)
# If not configured, receipts will be logged but not sent
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# SMTP_AUTH=true
# SMTP_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_AUTH=true
SMTP_TLS=true
